[Unit]
Description=AI Rádió – webes irányítópult (csak helyben, SSH-alagúton át érhető el)
After=network-online.target airadio-radio.service

[Service]
User=airadio
Group=airadio
EnvironmentFile=/etc/airadio/airadio.env
Environment=AIRADIO_CONFIG=/etc/airadio/radio.toml
Environment=TZ=Europe/Budapest
ExecStart=/opt/airadio/venv/bin/airadio dashboard --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
